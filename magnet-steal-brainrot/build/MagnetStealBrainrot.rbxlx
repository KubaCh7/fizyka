        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">GameClient</string>
          <string name="Source"><![CDATA[-- Magnet & Steal a Brainrot - punkt startowy klienta.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local UI = require(script.UI)
local Effects = require(script.Effects)
local Minigame = require(script.Minigame)
local Tug = require(script.Tug)
local ShopUI = require(script.ShopUI)
local IndexUI = require(script.IndexUI)
local Tools = require(script.Tools)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local refs = UI.build()
Effects.start()
Minigame.init()
Tug.init()
ShopUI.init()
IndexUI.init()
Tools.init()

refs.shopButton.MouseButton1Click:Connect(ShopUI.toggle)
refs.indexButton.MouseButton1Click:Connect(IndexUI.toggle)
refs.devButton.MouseButton1Click:Connect(function()
	Remotes.DevCheat:FireServer()
end)

Remotes.Notify.OnClientEvent:Connect(function(text, kind)
	UI.toast(text, kind)
end)

Remotes.Ragdoll.OnClientEvent:Connect(function(seconds, impulse)
	Effects.ragdoll(seconds, impulse)
end)

local function nearMe(position: Vector3?, radius: number): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root ~= nil and position ~= nil and (root.Position - position).Magnitude <= radius
end

Remotes.Alert.OnClientEvent:Connect(function(data)
	local kind = data.kind
	local rarity = Config.Rarities[data.rarity or 1] or Config.Rarities[1]
	if kind == "catch" then
		local isMe = data.player == player.DisplayName
		UI.banner(
			string.upper(rarity.id) .. " DROP!",
			data.player .. " wyłowił: " .. data.itemName .. " (strefa " .. tostring(data.zone) .. ")",
			rarity.color,
			if rarity.id == "Mythic" then 7 else 5
		)
		UI.flash(rarity.color, if isMe then 0.8 else 0.45)
		Effects.play("Alert", 0.9)
		Effects.shake(if isMe then 4 else 2, 0.6)
	elseif kind == "hooked" then
		UI.banner(
			"NA HACZYKU: " .. string.upper(rarity.id) .. "!",
			data.player .. " wyciąga coś ogromnego w strefie " .. tostring(data.zone) .. " - słup światła wskazuje miejsce!",
			rarity.color,
			4
		)
		Effects.play("Clank", 0.8, 0.8)
	elseif kind == "steal" then
		local text = data.player .. " ukradł " .. data.itemName .. " graczowi " .. data.victim .. "!"
		if rarity.inHands then
			UI.banner("KRADZIEŻ " .. string.upper(rarity.id) .. "!", text, rarity.color, 4)
			Effects.play("Steal", 0.9, 0.8)
		else
			UI.toast(text, "info")
		end
	elseif kind == "sunk" then
		UI.banner(
			string.upper(rarity.id) .. " ZATONĄŁ!",
			data.itemName .. " leży na dnie" .. (if data.player ~= "" then " (wypadł graczowi " .. data.player .. ")" else "") .. ". Kto pierwszy rzuci magnes, ten bierze!",
			rarity.color,
			5
		)
	elseif kind == "splash" then
		if nearMe(data.position, 90) then
			Effects.play("Splash", 0.9)
		end
	elseif kind == "slip" then
		if nearMe(data.position, 70) then
			Effects.play("Slip", 0.8)
		end
	elseif kind == "event" then
		UI.banner(data.title, data.text, Color3.fromRGB(150, 110, 255), 5)
		if data.on then
			UI.flash(Color3.fromRGB(120, 80, 255), 0.5)
			Effects.play("Alert", 0.7, 0.7)
		end
	elseif kind == "rebirth" then
		UI.toast(data.player .. " zrobił REBIRTH " .. tostring(data.rebirths) .. "!", "good")
	elseif kind == "collect" then
		UI.toast("+" .. Format.money(data.amount) .. " z Kasy garażu", "good")
		Effects.play("Buy", 0.6, 1.2)
	end
end)

for _, name in ipairs({ "Cash", "CPS", "Pending", "Carried", "Capacity", "Magnet", "Protected" }) do
	player:GetAttributeChangedSignal(name):Connect(UI.refreshStats)
end
workspace:GetAttributeChangedSignal("Storm"):Connect(UI.refreshStats)
UI.refreshStats()

task.spawn(function()
	while true do
		UI.refreshZone()
		task.wait(0.25)
	end
end)

UI.toast("Weź Wędkę Magnetyczną (1), podejdź do kanału i przytrzymaj klik!", "info")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[-- Dźwięki, wstrząsy kamery, tęczowe mutacje i ragdoll (poślizg/szarpnięcie).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local player = Players.LocalPlayer
local Effects = {}

local soundCache: { [string]: Sound } = {}

function Effects.play(name: string, volume: number?, pitch: number?)
	local id = (Config.Sounds :: any)[name]
	if not id then
		return
	end
	local sound = soundCache[name]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Parent = SoundService
		soundCache[name] = sound
	end
	sound.Volume = volume or 0.6
	sound.PlaybackSpeed = pitch or 1
	sound.TimePosition = 0
	sound:Play()
end

local shakeUntil, shakePower = 0, 0
function Effects.shake(power: number, seconds: number)
	shakePower = math.max(shakePower, power)
	shakeUntil = math.max(shakeUntil, os.clock() + seconds)
end

local rainbowParts: { BasePart } = {}
local function track(inst: Instance)
	if inst:IsA("BasePart") then
		table.insert(rainbowParts, inst)
	end
end

function Effects.start()
	for _, inst in ipairs(CollectionService:GetTagged("Rainbow")) do
		track(inst)
	end
	CollectionService:GetInstanceAddedSignal("Rainbow"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("Rainbow"):Connect(function(inst)
		local i = table.find(rainbowParts, inst :: any)
		if i then
			table.remove(rainbowParts, i)
		end
	end)

	-- Po skrypcie kamery, żeby wstrząs nie był nadpisany
	RunService:BindToRenderStep("MSB_Effects", Enum.RenderPriority.Camera.Value + 1, function()
		local t = os.clock()
		local hue = (t * 0.25) % 1
		for _, p in ipairs(rainbowParts) do
			p.Color = Color3.fromHSV(hue, 0.8, 1)
		end
		if t < shakeUntil then
			local camera = workspace.CurrentCamera
			local f = shakePower * ((shakeUntil - t) / 0.5)
			camera.CFrame *= CFrame.Angles(
				math.rad((math.random() - 0.5) * f),
				math.rad((math.random() - 0.5) * f),
				0
			)
		else
			shakePower = 0
		end
	end)
end

-- Ragdoll po stronie klienta (postać jest własnością klienta fizycznie)
function Effects.ragdoll(seconds: number, impulse: Vector3)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not humanoid or not root then
		return
	end
	Effects.play("Slip", 0.8)
	humanoid.PlatformStand = true
	root.AssemblyLinearVelocity = impulse
	root.AssemblyAngularVelocity = Vector3.new(math.random(-6, 6), math.random(-3, 3), math.random(-6, 6))
	task.delay(seconds, function()
		if humanoid.Parent then
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

return Effects
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">IndexUI</string>
            <string name="Source"><![CDATA[-- Index (kolekcja): 30 Brainrotów, odkryte pokazują nazwę i kolor tieru.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Brainrots = require(Shared.Brainrots)

local UI = require(script.Parent.UI)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local IndexUI = {}

local frame: Frame
local cells: { [string]: TextLabel } = {}
local counter: TextLabel
local discovered: { [string]: boolean } = {}

function IndexUI.refresh()
	local found = 0
	for _, b in ipairs(Brainrots.List) do
		local cell = cells[b.id]
		local rarity = Config.Rarities[Config.RarityIndex[b.rarity]]
		if discovered[b.id] then
			found += 1
			cell.Text = b.name
			cell.TextColor3 = rarity.color
			cell.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		else
			cell.Text = "??? (" .. b.rarity .. ")"
			cell.TextColor3 = Color3.fromRGB(110, 110, 120)
			cell.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
		end
	end
	counter.Text = ("Odkryto %d / %d"):format(found, #Brainrots.List)
end

function IndexUI.toggle()
	frame.Visible = not frame.Visible
	IndexUI.refresh()
end

function IndexUI.init()
	frame = UI.make("Frame", {
		Name = "Index",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 720, 0, 460),
		BackgroundColor3 = Color3.fromRGB(22, 20, 32),
		Visible = false,
		ZIndex = 40,
		Parent = UI.root(),
	}, { UI.corner(16), UI.stroke(3, Color3.fromRGB(140, 110, 255)) })
	UI.label({
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(0.5, 0, 0, 36),
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "BRAINROT INDEX",
		TextColor3 = Color3.fromRGB(170, 140, 255),
		ZIndex = 41,
		Parent = frame,
	})
	counter = UI.label({
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.new(0.5, -70, 0, 28),
		Text = "",
		ZIndex = 41,
		Parent = frame,
	})
	local closeButton = UI.button("X", Color3.fromRGB(200, 60, 60), {
		Position = UDim2.new(1, -54, 0, 8),
		Size = UDim2.new(0, 44, 0, 36),
		ZIndex = 41,
		Parent = frame,
	})
	closeButton.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	-- Siatka: kolumna = strefa, wiersz = rzadkość
	local grid = UI.make("Frame", {
		Position = UDim2.new(0, 12, 0, 52),
		Size = UDim2.new(1, -24, 1, -64),
		BackgroundTransparency = 1,
		ZIndex = 41,
		Parent = frame,
	})
	local zones = #Config.Zones
	local rarities = #Config.Rarities
	for z = 1, zones do
		UI.label({
			Position = UDim2.new((z - 1) / zones, 2, 0, 0),
			Size = UDim2.new(1 / zones, -4, 0, 24),
			Text = z .. ". " .. Config.Zones[z].name,
			TextColor3 = Config.Zones[z].color,
			ZIndex = 42,
			Parent = grid,
		})
	end
	for _, b in ipairs(Brainrots.List) do
		local r = Config.RarityIndex[b.rarity]
		local cell = UI.label({
			Position = UDim2.new((b.zone - 1) / zones, 3, 0, 28 + (r - 1) * 60),
			Size = UDim2.new(1 / zones, -6, 0, 54),
			BackgroundTransparency = 0,
			TextStrokeTransparency = 0.6,
			ZIndex = 42,
			Text = "",
			Parent = grid,
		})
		UI.corner(8).Parent = cell
		UI.make("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = cell })
		cells[b.id] = cell
	end
	assert(rarities == 6, "Siatka Indexu zakłada 6 rzadkości")

	Remotes.IndexUpdate.OnClientEvent:Connect(function(index)
		if type(index) == "table" then
			discovered = index
			IndexUI.refresh()
		end
	end)
	IndexUI.refresh()
end

return IndexUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Minigame</string>
            <string name="Source"><![CDATA[-- Minigra łowienia: opadanie magnesu -> "KLANG!" (Hook Check) -> wyciąganie.
-- Wyciąganie: trzymaj obiekt w polu magnetycznym, pilnuj napięcia liny
-- (sweet spot 40-70% daje +25% postępu, 100% = zerwana lina) i trafiaj
-- skill-checki przy szarpnięciach.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local F = Config.Fishing
local BAR_W = 480
local QTE_POINTS = {
	[1] = { 0.6 },
	[2] = { 0.45, 0.75 },
	[3] = { 0.4, 0.6, 0.8 },
}

local Minigame = {}

local active: any = nil -- stan bieżącej minigry
local gui: { [string]: any } = {}

local function build()
	local root = UI.root()
	gui.catcher = UI.make("TextButton", {
		Name = "HoldCatcher",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Visible = false,
		ZIndex = 20,
		Parent = UI.overlay(),
	})
	gui.panel = UI.make("Frame", {
		Name = "Minigame",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -110),
		Size = UDim2.new(0, BAR_W + 40, 0, 210),
		BackgroundColor3 = Color3.fromRGB(18, 22, 30),
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 21,
		Parent = root,
	}, { UI.corner(14) })
	gui.panelStroke = UI.stroke(3, Color3.new(1, 1, 1))
	gui.panelStroke.Parent = gui.panel

	gui.title = UI.label({
		Position = UDim2.new(0, 20, 0, 6),
		Size = UDim2.new(1, -40, 0, 32),
		ZIndex = 22,
		Text = "",
		Parent = gui.panel,
	})
	gui.bar = UI.make("Frame", {
		Position = UDim2.new(0, 20, 0, 44),
		Size = UDim2.new(0, BAR_W, 0, 46),
		BackgroundColor3 = Color3.fromRGB(40, 60, 50),
		ZIndex = 22,
		Parent = gui.panel,
	}, { UI.corner(8), UI.stroke(2) })
	gui.field = UI.make("Frame", {
		Size = UDim2.new(0.25, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(90, 230, 120),
		BackgroundTransparency = 0.35,
		ZIndex = 23,
		Parent = gui.bar,
	}, { UI.corner(8) })
	gui.object = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 34, 0, 34),
		BackgroundTransparency = 0,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "?",
		TextColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 1,
		ZIndex = 24,
		Parent = gui.bar,
	})
	UI.corner(17).Parent = gui.object

	local function meter(y: number, label: string): (Frame, Frame)
		UI.label({
			Position = UDim2.new(0, 20, 0, y),
			Size = UDim2.new(0, 90, 0, 18),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 22,
			Text = label,
			Parent = gui.panel,
		})
		local back = UI.make("Frame", {
			Position = UDim2.new(0, 115, 0, y + 2),
			Size = UDim2.new(0, BAR_W - 95, 0, 14),
			BackgroundColor3 = Color3.fromRGB(35, 35, 40),
			ZIndex = 22,
			Parent = gui.panel,
		}, { UI.corner(6) })
		local fill = UI.make("Frame", {
			Size = UDim2.new(0, 0, 1, 0),
			BackgroundColor3 = Color3.fromRGB(90, 230, 120),
			ZIndex = 24,
			Parent = back,
		}, { UI.corner(6) })
		return back, fill
	end
	local _, progressFill = meter(100, "Postęp")
	gui.progress = progressFill
	local tensionBack, tensionFill = meter(124, "Napięcie")
	gui.tension = tensionFill
	UI.make("Frame", {
		Position = UDim2.new(F.SweetSpotMin, 0, 0, 0),
		Size = UDim2.new(F.SweetSpotMax - F.SweetSpotMin, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.75,
		ZIndex = 23,
		Parent = tensionBack,
	})

	gui.hint = UI.label({
		Position = UDim2.new(0, 20, 0, 146),
		Size = UDim2.new(1, -40, 0, 22),
		ZIndex = 22,
		TextColor3 = Color3.fromRGB(200, 200, 210),
		Text = "",
		Parent = gui.panel,
	})
	gui.status = UI.label({
		Position = UDim2.new(0, 20, 0, 172),
		Size = UDim2.new(1, -40, 0, 28),
		ZIndex = 22,
		Text = "",
		Parent = gui.panel,
	})

	-- Skill-check (szarpnięcie)
	gui.qte = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -12),
		Size = UDim2.new(0, 380, 0, 34),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		Visible = false,
		ZIndex = 25,
		Parent = gui.panel,
	}, { UI.corner(8), UI.stroke(3, Color3.fromRGB(255, 200, 60)) })
	gui.qteGood = UI.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(240, 200, 60),
		ZIndex = 26,
		Parent = gui.qte,
	})
	gui.qtePerfect = UI.make("Frame", {
		BackgroundColor3 = Color3.fromRGB(80, 230, 100),
		ZIndex = 27,
		Parent = gui.qte,
	})
	gui.qteNeedle = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 6, 1.3, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 28,
		Parent = gui.qte,
	})
	UI.label({
		Position = UDim2.new(0, 0, -1, -2),
		Size = UDim2.new(1, 0, 1, 0),
		ZIndex = 26,
		Text = "SZARPNIĘCIE! Kliknij na zielonym!",
		TextColor3 = Color3.fromRGB(255, 220, 80),
		Parent = gui.qte,
	})
end

local function setVisible(on: boolean)
	gui.panel.Visible = on
	gui.catcher.Visible = on
	if not on then
		gui.qte.Visible = false
	end
end

local function close()
	if active and active.conn then
		active.conn:Disconnect()
	end
	active = nil
	setVisible(false)
	ContextActionService:UnbindAction("MSB_Reel")
end

local function send(success: boolean, reason: string?)
	if not active or active.sent then
		return
	end
	active.sent = true
	Remotes.FishResult:FireServer(active.token, success, reason)
end

local function finish(success: boolean, reason: string?)
	if not active or active.done then
		return
	end
	active.done = true
	send(success, reason)
	local rarity = Config.Rarities[active.params.rarity]
	if success then
		gui.status.Text = "WYŁOWIONE!"
		gui.status.TextColor3 = rarity.color
		Effects.play("Catch", 0.8)
		if active.params.rarity >= 3 then
			UI.flash(rarity.color, 0.5)
		end
	else
		gui.status.Text = if reason == "snap" then "LINA PĘKŁA!" elseif reason == "hook" then "Za późno! Magnes się odczepił" else "Uciekło..."
		gui.status.TextColor3 = Color3.fromRGB(255, 100, 100)
		Effects.play("Snap", 0.7)
	end
	local me = active
	task.delay(1.2, function()
		if active == me then
			close()
		end
	end)
end

local function startQte()
	local a = active
	local rarity = Config.Rarities[a.params.rarity]
	a.qte = {
		t = 0,
		duration = 1.1,
		center = 0.3 + math.random() * 0.55,
		perfect = rarity.perfect,
		good = rarity.good,
	}
	gui.qtePerfect.Size = UDim2.new(rarity.perfect, 0, 1, 0)
	gui.qtePerfect.Position = UDim2.new(a.qte.center - rarity.perfect / 2, 0, 0, 0)
	gui.qteGood.Size = UDim2.new(rarity.good, 0, 1, 0)
	gui.qteGood.Position = UDim2.new(a.qte.center - rarity.good / 2, 0, 0, 0)
	gui.qte.Visible = true
	a.holding = false
	Effects.play("Clank", 0.5, 1.3)
	Effects.shake(1.5, 0.3)
end

local function resolveQte(pressed: boolean)
	local a = active
	local q = a.qte
	local dist = math.abs(q.t / q.duration - q.center)
	local result
	if pressed and dist <= q.perfect / 2 then
		result = "PERFECT!"
		a.progress = math.min(1, a.progress + 0.10)
		a.tension = math.max(0, a.tension - 0.20)
	elseif pressed and dist <= q.good / 2 then
		result = "Dobrze"
		a.progress = math.min(1, a.progress + 0.03)
	else
		result = "Pudło!"
		a.progress -= 0.15
		a.tension += 0.25 * a.tMult
	end
	gui.status.Text = result
	gui.status.TextColor3 = if result == "Pudło!" then Color3.fromRGB(255, 110, 110) else Color3.fromRGB(120, 255, 140)
	a.qte = nil
	gui.qte.Visible = false
end

local function press()
	local a = active
	if not a or a.done then
		return
	end
	if a.phase == "bite" then
		a.phase = "reel"
		gui.status.Text = ""
		gui.hint.Text = "Trzymaj = pole w prawo · puść = w lewo · pilnuj napięcia!"
		return
	end
	if a.phase ~= "reel" then
		return
	end
	if a.qte then
		resolveQte(true)
		return
	end
	a.holding = true
end

local function release()
	if active then
		active.holding = false
	end
end

local function step(dt: number)
	local a = active
	if not a or a.done then
		return
	end
	local params = a.params
	local rarity = Config.Rarities[params.rarity]
	a.elapsed += dt

	if a.phase == "wait" then
		gui.status.Text = "Magnes opada" .. string.rep(".", 1 + math.floor(a.elapsed * 3) % 3)
		if a.elapsed >= params.biteDelay then
			Effects.play("Clank", 1)
			Effects.shake(2.5, 0.35)
			gui.object.BackgroundColor3 = rarity.color
			if params.tooHeavy then
				a.phase = "tease"
				gui.title.Text = "KLANG! Coś ogromnego..."
				gui.title.TextColor3 = rarity.color
				gui.status.Text = (params.teaseName or "???") .. " · " .. params.weight .. " kg"
				gui.status.TextColor3 = rarity.color
				gui.hint.Text = "Za słaby magnes: potrzebujesz " .. params.needPull .. " kg siły (masz " .. params.pull .. " kg)"
				a.done = true
				task.delay(2.5, function()
					if active == a then
						close()
					end
				end)
				return
			end
			a.phase = "bite"
			a.biteAt = a.elapsed
			gui.status.Text = "KLANG! KLIKNIJ TERAZ!"
			gui.status.TextColor3 = Color3.fromRGB(255, 220, 60)
			if params.rarity >= 3 then
				UI.flash(rarity.color, 0.35)
			end
		end
		return
	elseif a.phase == "bite" then
		if a.elapsed - a.biteAt > params.hookWindow + 0.15 then
			finish(false, "hook")
		end
		return
	elseif a.phase ~= "reel" then
		return
	end

	-- Skill-check wstrzymuje resztę minigry
	if a.qte then
		a.qte.t += dt
		gui.qteNeedle.Position = UDim2.new(math.clamp(a.qte.t / a.qte.duration, 0, 1), 0, 0.5, 0)
		if a.qte.t >= a.qte.duration then
			resolveQte(false)
		end
		return
	end

	-- Klątwa: okresowo odwrócone sterowanie
	if params.rarity == Config.RarityIndex.Cursed then
		a.curseTimer -= dt
		if a.curseTimer <= 0 then
			a.reversed = not a.reversed
			a.curseTimer = if a.reversed then 1.5 else 3 + math.random() * 2
			gui.hint.Text = if a.reversed then "KLĄTWA! ODWRÓCONE STEROWANIE!" else "Trzymaj = pole w prawo · puść = w lewo"
		end
	end

	-- Pole magnetyczne gracza
	local push = a.holding
	if a.reversed then
		push = not push
	end
	a.v = math.clamp(a.v + (if push then F.FieldAccel else -F.FieldAccel) * dt, -F.FieldMaxSpeed, F.FieldMaxSpeed)
	a.fieldPos += a.v * dt
	if a.fieldPos < 0 then
		a.fieldPos = 0
		a.v = -a.v * 0.3
	elseif a.fieldPos > 1 - a.fieldW then
		a.fieldPos = 1 - a.fieldW
		a.v = -a.v * 0.3
	end

	-- Obiekt ucieka do losowych celów, czasem z "dashem"
	a.retarget -= dt
	if a.retarget <= 0 then
		a.target = 0.05 + math.random() * 0.9
		a.retarget = rarity.retarget * (0.6 + math.random() * 0.8)
		a.dash = math.random() < 0.25
	end
	local speed = rarity.speed * (if a.dash then 2 else 1)
	local diff = a.target - a.objPos
	a.objPos += math.sign(diff) * math.min(math.abs(diff), speed * dt)

	local inside = a.objPos >= a.fieldPos and a.objPos <= a.fieldPos + a.fieldW

	if a.holding then
		a.tension += (if inside then F.TensionHoldInside else F.TensionHoldOutside) * a.tMult * dt
	else
		a.tension -= F.TensionRelease * dt
	end
	a.tension = math.clamp(a.tension, 0, 1)
	if a.tension >= 1 then
		finish(false, "snap")
		return
	end

	local sweet = a.tension >= F.SweetSpotMin and a.tension <= F.SweetSpotMax
	if inside then
		a.progress += a.gain * dt * (if sweet then F.SweetSpotBonus else 1)
	else
		a.progress -= a.drain * dt
	end

	if a.progress >= 1 then
		a.progress = 1
		finish(true)
	elseif a.progress <= 0 then
		a.progress = 0
		finish(false, "escaped")
	elseif a.nextQte <= #a.qtePoints and a.progress >= a.qtePoints[a.nextQte] then
		a.nextQte += 1
		startQte()
	end

	-- Rysowanie
	gui.field.Size = UDim2.new(a.fieldW, 0, 1, 0)
	gui.field.Position = UDim2.new(a.fieldPos, 0, 0, 0)
	gui.field.BackgroundColor3 = if inside then Color3.fromRGB(90, 230, 120) else Color3.fromRGB(200, 200, 200)
	gui.object.Position = UDim2.new(a.objPos, 0, 0.5, 0)
	gui.progress.Size = UDim2.new(a.progress, 0, 1, 0)
	gui.tension.Size = UDim2.new(a.tension, 0, 1, 0)
	gui.tension.BackgroundColor3 = if a.tension > 0.85
		then Color3.fromRGB(255, 70, 70)
		elseif sweet then Color3.fromRGB(90, 230, 120)
		else Color3.fromRGB(240, 200, 60)
end

function Minigame.isActive(): boolean
	return active ~= nil
end

function Minigame.start(params: { [string]: any })
	if params.cancel then
		if active then
			gui.status.Text = "Przerwano!"
			gui.status.TextColor3 = Color3.fromRGB(255, 100, 100)
			active.done = true
			active.sent = true
			local me = active
			task.delay(1, function()
				if active == me then
					close()
				end
			end)
		end
		return
	end
	if active then
		close()
	end
	local rarity = Config.Rarities[params.rarity]
	local gainRatio = math.clamp(math.sqrt(params.pull / math.max(params.weight, 1)), 0.6, 1.6)
	active = {
		token = params.token,
		params = params,
		phase = "wait",
		elapsed = 0,
		biteAt = 0,
		holding = false,
		reversed = false,
		curseTimer = 2,
		v = 0,
		fieldW = if params.rarity == 1 and (player:GetAttribute("Magnet") or 1) == 1 then 0.32 else params.field,
		fieldPos = 0.35,
		objPos = 0.5,
		target = 0.5,
		retarget = 0.5,
		dash = false,
		progress = F.StartProgress,
		tension = F.TensionStart,
		gain = F.BaseGain * gainRatio * params.reel,
		drain = F.BaseDrain * rarity.drain,
		tMult = (100 / params.durability) * (if params.weight > params.pull then 1.2 else 1),
		qtePoints = QTE_POINTS[rarity.qte] or {},
		nextQte = 1,
		qte = nil,
		done = false,
		sent = false,
		conn = nil,
	}
	gui.title.Text = "Wyciąganie: ??? " .. (if params.perfectCast then "· PERFECT CAST!" else "")
	gui.title.TextColor3 = Color3.new(1, 1, 1)
	gui.panelStroke.Color = Color3.new(1, 1, 1)
	gui.object.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
	gui.status.Text = ""
	gui.hint.Text = "Czekaj na KLANG!, potem kliknij / dotknij"
	gui.progress.Size = UDim2.new(active.progress, 0, 1, 0)
	gui.tension.Size = UDim2.new(active.tension, 0, 1, 0)
	setVisible(true)
	Effects.play("Cast", 0.6)

	ContextActionService:BindActionAtPriority("MSB_Reel", function(_, state)
		if state == Enum.UserInputState.Begin then
			press()
		elseif state == Enum.UserInputState.End then
			release()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonR2)

	active.conn = RunService.RenderStepped:Connect(step)
	-- Tytuł z kolorem tieru pojawia się dopiero po zaczepieniu
	task.delay(params.biteDelay, function()
		if active and active.token == params.token and not params.tooHeavy then
			gui.title.Text = "Wyciąganie: " .. string.upper(rarity.id) .. (if params.perfectCast then " · PERFECT CAST!" else "")
			gui.title.TextColor3 = rarity.color
			gui.panelStroke.Color = rarity.color
		end
	end)
end

function Minigame.init()
	build()
	gui.catcher.MouseButton1Down:Connect(press)
	gui.catcher.MouseButton1Up:Connect(release)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			release()
		end
	end)
	Remotes.FishStart.OnClientEvent:Connect(Minigame.start)
end

return Minigame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[-- Sklep: magnesy, liny, transport, garaż, przedmioty, Rebirth.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)

local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local ShopUI = {}

local frame: Frame
local rows: { [string]: { title: TextLabel, desc: TextLabel, button: TextButton } } = {}

local function attr(name: string, default: any): any
	local v = player:GetAttribute(name)
	if v == nil then
		return default
	end
	return v
end

local function rebirthCost(r: number): number
	return Config.Rebirth.baseCost * Config.Rebirth.costGrowth ^ r
end

-- Opis aktualnego i następnego poziomu dla każdej ścieżki
local function describe(category: string): (string, string, number?)
	if category == "Magnet" then
		local lvl = attr("Magnet", 1)
		local cur, nxt = Config.Magnets[lvl], Config.Magnets[lvl + 1]
		local desc = ("Teraz: %s · %d kg · zasięg %d m · luck +%d%%"):format(cur.name, cur.pull, cur.reach, math.floor(cur.luck * 100))
		if not nxt then
			return "Magnes (MAX)", desc, nil
		end
		return "Magnes → " .. nxt.name, desc .. ("\nNastępny: %d kg · zasięg %d m · pole %d%% · CD %.1f s"):format(nxt.pull, nxt.reach, math.floor(nxt.field * 100), nxt.cooldown), nxt.price
	elseif category == "Rope" then
		local lvl = attr("Rope", 1)
		local cur, nxt = Config.Ropes[lvl], Config.Ropes[lvl + 1]
		local desc = ("Teraz: %s · wytrzymałość %d · zasięg kradzieży %d"):format(cur.name, cur.durability, cur.pvpRange)
		if not nxt then
			return "Lina (MAX)", desc, nil
		end
		return "Lina → " .. nxt.name, desc .. ("\nNastępna: wytrzymałość %d · nawijanie x%.2f · zasięg %d"):format(nxt.durability, nxt.reel, nxt.pvpRange), nxt.price
	elseif category == "Transport" then
		local lvl = attr("Transport", 1)
		local cur, nxt = Config.Transports[lvl], Config.Transports[lvl + 1]
		local desc = ("Teraz: %s · %d szt."):format(cur.name, cur.capacity)
		if not nxt then
			return "Transport (MAX)", desc, nil
		end
		return "Transport → " .. nxt.name, desc .. ("\nNastępny: %d szt. naraz"):format(nxt.capacity), nxt.price
	elseif category == "Garage" then
		local lvl = attr("Garage", 1)
		local cur, nxt = Config.GarageLevels[lvl], Config.GarageLevels[lvl + 1]
		local desc = ("Teraz: %d stojaków"):format(cur.slots)
		if not nxt then
			return "Garaż (MAX)", desc, nil
		end
		return "Rozbudowa garażu → " .. nxt.slots .. " stojaków", desc, nxt.price
	elseif category == "Banana" then
		local cfg = Config.Items.BananaPack
		return cfg.name, "Pułapka: kto wejdzie, ten leży 1,5 s i gubi łup. Masz: " .. attr("Bananas", 0), cfg.price
	elseif category == "Shield" then
		local cfg = Config.Items.Shield
		if attr("HasShield", false) then
			return cfg.name .. " (KUPIONA)", "Odporność na kradzież przez " .. cfg.duration .. " s, CD " .. cfg.cooldown .. " s", nil
		end
		return cfg.name, "Odporność na kradzież przez " .. cfg.duration .. " s, CD " .. cfg.cooldown .. " s", cfg.price
	elseif category == "Rebirth" then
		local r = attr("Rebirths", 0)
		return "REBIRTH " .. (r + 1),
			("Reset postępu za +%d%% CPS i +%d%% Luck na zawsze. Masz %d Rebirth."):format(
				math.floor(Config.Rebirth.cpsBonus * 100),
				math.floor(Config.Rebirth.luckBonus * 100),
				r
			),
			rebirthCost(r)
	end
	return category, "", nil
end

local ORDER = { "Magnet", "Rope", "Transport", "Garage", "Banana", "Shield", "Rebirth" }

function ShopUI.refresh()
	if not frame or not frame.Visible then
		return
	end
	local cash = attr("Cash", 0)
	for _, category in ipairs(ORDER) do
		local row = rows[category]
		local title, desc, price = describe(category)
		row.title.Text = title
		row.desc.Text = desc
		if price then
			row.button.Text = Format.money(price)
			row.button.BackgroundColor3 = if cash >= price then Color3.fromRGB(50, 180, 80) else Color3.fromRGB(110, 110, 115)
			row.button.Active = true
		else
			row.button.Text = "—"
			row.button.BackgroundColor3 = Color3.fromRGB(70, 70, 75)
			row.button.Active = false
		end
	end
end

function ShopUI.toggle()
	frame.Visible = not frame.Visible
	ShopUI.refresh()
end

function ShopUI.init()
	frame = UI.make("Frame", {
		Name = "Shop",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.new(0, 640, 0, 520),
		BackgroundColor3 = Color3.fromRGB(25, 25, 32),
		Visible = false,
		ZIndex = 40,
		Parent = UI.root(),
	}, { UI.corner(16), UI.stroke(3, Color3.fromRGB(255, 170, 30)) })
	UI.make("UISizeConstraint", { MaxSize = Vector2.new(640, 520), Parent = frame })
	UI.label({
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(1, -80, 0, 40),
		Text = "SKLEP ZŁOMIARZA",
		TextColor3 = Color3.fromRGB(255, 190, 60),
		ZIndex = 41,
		Parent = frame,
	})
	local closeButton = UI.button("X", Color3.fromRGB(200, 60, 60), {
		Position = UDim2.new(1, -54, 0, 8),
		Size = UDim2.new(0, 44, 0, 40),
		ZIndex = 41,
		Parent = frame,
	})
	closeButton.MouseButton1Click:Connect(function()
		frame.Visible = false
	end)

	local list = UI.make("ScrollingFrame", {
		Position = UDim2.new(0, 12, 0, 56),
		Size = UDim2.new(1, -24, 1, -68),
		BackgroundTransparency = 1,
		ScrollBarThickness = 8,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 41,
		Parent = frame,
	})
	UI.make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	for i, category in ipairs(ORDER) do
		local row = UI.make("Frame", {
			LayoutOrder = i,
			Size = UDim2.new(1, -10, 0, 74),
			BackgroundColor3 = Color3.fromRGB(40, 40, 50),
			ZIndex = 42,
			Parent = list,
		}, { UI.corner(10) })
		local title = UI.label({
			Position = UDim2.new(0, 10, 0, 4),
			Size = UDim2.new(1, -150, 0, 28),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 43,
			Text = category,
			Parent = row,
		})
		local desc = UI.label({
			Position = UDim2.new(0, 10, 0, 32),
			Size = UDim2.new(1, -150, 0, 38),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			TextColor3 = Color3.fromRGB(200, 200, 210),
			TextStrokeTransparency = 1,
			ZIndex = 43,
			Text = "",
			Parent = row,
		})
		local button = UI.button("$", Color3.fromRGB(50, 180, 80), {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.new(0, 125, 0, 50),
			ZIndex = 43,
			Parent = row,
		})
		button.MouseButton1Click:Connect(function()
			local ok, msg = Remotes.Purchase:InvokeServer(category)
			UI.toast(msg, if ok then "good" else "bad")
			if ok then
				Effects.play("Buy", 0.7)
			end
			ShopUI.refresh()
		end)
		rows[category] = { title = title, desc = desc, button = button }
	end

	for _, name in ipairs({ "Cash", "Magnet", "Rope", "Transport", "Garage", "Bananas", "HasShield", "Rebirths" }) do
		player:GetAttributeChangedSignal(name):Connect(ShopUI.refresh)
	end
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">Tools</string>
            <string name="Source"><![CDATA[-- Obsługa narzędzi: wędka (ładowanie rzutu), hak do kradzieży, banan, tarcza.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)
local Minigame = require(script.Parent.Minigame)
local Tug = require(script.Parent.Tug)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local mouse = player:GetMouse()

local Tools = {}

local bound: { [Tool]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local charging = false
local chargeStart = 0

local CHARGE_PERIOD = 1.2

local function chargePower(): number
	-- Ping-pong 0 -> 1 -> 0
	local t = ((os.clock() - chargeStart) / CHARGE_PERIOD) % 2
	return if t <= 1 then t else 2 - t
end

local function busy(): boolean
	return Minigame.isActive() or Tug.isActive()
end

local function bindFishing(tool: Tool)
	tool.Activated:Connect(function()
		if busy() or charging then
			return
		end
		charging = true
		chargeStart = os.clock()
		UI.refs().charge.Visible = true
	end)
	local function releaseCast()
		if not charging then
			return
		end
		charging = false
		UI.refs().charge.Visible = false
		Remotes.CastRequest:FireServer(chargePower())
	end
	tool.Deactivated:Connect(releaseCast)
	tool.Unequipped:Connect(function()
		charging = false
		UI.refs().charge.Visible = false
	end)
end

local function bindSteal(tool: Tool)
	tool.Activated:Connect(function()
		if busy() then
			return
		end
		Effects.play("Steal", 0.5, 1.2)
		Remotes.StealRequest:FireServer(mouse.Hit.Position)
	end)
end

local function bindTool(tool: Instance)
	if not tool:IsA("Tool") or bound[tool] then
		return
	end
	bound[tool] = true
	if tool.Name == "Wędka Magnetyczna" then
		bindFishing(tool)
	elseif tool.Name == "Hak do Kradzieży" then
		bindSteal(tool)
	elseif tool.Name == "Skórka od Banana" then
		tool.Activated:Connect(function()
			Remotes.PlaceBanana:FireServer()
		end)
	elseif tool.Name == "Tarcza Magnesowa" then
		tool.Activated:Connect(function()
			Remotes.UseShield:FireServer()
		end)
	end
end

local function watch(container: Instance)
	for _, child in ipairs(container:GetChildren()) do
		bindTool(child)
	end
	container.ChildAdded:Connect(bindTool)
end

function Tools.init()
	watch(player:WaitForChild("Backpack"))
	player.CharacterAdded:Connect(function(character)
		watch(character)
		watch(player:WaitForChild("Backpack"))
	end)
	if player.Character then
		watch(player.Character)
	end

	RunService.RenderStepped:Connect(function()
		if charging then
			UI.refs().chargeNeedle.Position = UDim2.new(chargePower(), 0, 0.5, 0)
		end
	end)
end

return Tools
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">Tug</string>
            <string name="Source"><![CDATA[-- UI przeciągania liny. Klikaj, gdy zmniejszający się pierścień dotknie
-- środka (takt co 0,6 s). Serwer ocenia każde kliknięcie i przesuwa linę.
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local S = Config.Steal

local Tug = {}

local gui: { [string]: any } = {}
local active: any = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

local function build()
	local root = UI.root()
	gui.panel = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.62, 0),
		Size = UDim2.new(0, 560, 0, 300),
		BackgroundColor3 = Color3.fromRGB(25, 15, 15),
		BackgroundTransparency = 0.1,
		Visible = false,
		ZIndex = 31,
		Parent = root,
	}, { UI.corner(16), UI.stroke(4, Color3.fromRGB(255, 70, 70)) })
	gui.title = UI.label({
		Position = UDim2.new(0, 16, 0, 8),
		Size = UDim2.new(1, -32, 0, 34),
		ZIndex = 32,
		Text = "PRZECIĄGANIE LINY!",
		TextColor3 = Color3.fromRGB(255, 90, 90),
		Parent = gui.panel,
	})
	gui.sub = UI.label({
		Position = UDim2.new(0, 16, 0, 42),
		Size = UDim2.new(1, -32, 0, 22),
		ZIndex = 32,
		Text = "",
		Parent = gui.panel,
	})
	gui.rope = UI.make("Frame", {
		Position = UDim2.new(0, 30, 0, 76),
		Size = UDim2.new(1, -60, 0, 26),
		BackgroundColor3 = Color3.fromRGB(120, 90, 60),
		ZIndex = 32,
		Parent = gui.panel,
	}, { UI.corner(8), UI.stroke(2) })
	UI.label({
		Position = UDim2.new(0, -26, 0, 0),
		Size = UDim2.new(0, 24, 1, 0),
		ZIndex = 33,
		Text = "TY",
		TextColor3 = Color3.fromRGB(120, 255, 140),
		Parent = gui.rope,
	})
	gui.marker = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.new(0, 16, 1.8, 0),
		BackgroundColor3 = Color3.fromRGB(255, 60, 60),
		ZIndex = 34,
		Parent = gui.rope,
	}, { UI.corner(4) })

	gui.target = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 185),
		Size = UDim2.new(0, 80, 0, 80),
		BackgroundColor3 = Color3.fromRGB(255, 200, 60),
		BackgroundTransparency = 0.3,
		ZIndex = 32,
		Parent = gui.panel,
	}, { UI.corner(40) })
	gui.ring = UI.make("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 185),
		Size = UDim2.new(0, 200, 0, 200),
		BackgroundTransparency = 1,
		ZIndex = 33,
		Parent = gui.panel,
	}, { UI.corner(100), UI.stroke(4, Color3.new(1, 1, 1)) })
	gui.judge = UI.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0, 185),
		Size = UDim2.new(0, 200, 0, 40),
		ZIndex = 35,
		Text = "",
		Parent = gui.panel,
	})
	gui.hint = UI.label({
		Position = UDim2.new(0, 16, 1, -34),
		Size = UDim2.new(1, -150, 0, 26),
		ZIndex = 32,
		TextColor3 = Color3.fromRGB(220, 220, 220),
		Text = "Klik / Spacja, gdy pierścień dotknie środka!",
		Parent = gui.panel,
	})
	-- Duży przycisk dla dotyku (pełnoekranowy łapacz blokowałby gałkę ruchu)
	gui.tapButton = UI.button("SZARP!", Color3.fromRGB(220, 50, 50), {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -12, 1, -12),
		Size = UDim2.new(0, 120, 0, 90),
		ZIndex = 36,
		Parent = gui.panel,
	})
end

local function close()
	if active and active.conn then
		active.conn:Disconnect()
	end
	active = nil
	gui.panel.Visible = false
	ContextActionService:UnbindAction("MSB_Tug")
end

local function tap()
	local a = active
	if not a or a.over then
		return
	end
	local t = now()
	local beat = math.floor((t - a.firstBeat) / a.interval + 0.5) + 1
	if beat < 1 or beat > a.maxBeats or a.tapped[beat] then
		return
	end
	a.tapped[beat] = true
	local offset = t - (a.firstBeat + (beat - 1) * a.interval)
	Remotes.TugTap:FireServer(a.id, beat, offset)
	Effects.play("Clank", 0.4, 1.6)
end

local function judgeText(mult: number): (string, Color3)
	if mult >= S.PerfectMult then
		return "PERFECT!", Color3.fromRGB(120, 255, 140)
	elseif mult >= S.GoodMult then
		return "Dobrze", Color3.fromRGB(255, 220, 80)
	end
	return "Pudło", Color3.fromRGB(255, 110, 110)
end

local function render()
	local a = active
	if not a then
		return
	end
	local t = now()
	if t < a.firstBeat then
		gui.judge.Text = tostring(math.ceil(a.firstBeat - t))
		gui.judge.TextColor3 = Color3.new(1, 1, 1)
	end
	-- Pierścień: maleje od 200 px do 80 px dokładnie w chwili taktu
	local phase = ((t - a.firstBeat) / a.interval) % 1
	local size = 80 + 120 * (1 - phase)
	gui.ring.Size = UDim2.new(0, size, 0, size)
	-- Pozycja liny z perspektywy gracza: wygrywasz, gdy znacznik idzie w lewo
	local mine = if a.role == "attacker" then a.pos else -a.pos
	gui.marker.Position = UDim2.new(math.clamp(0.5 - mine / (2 * a.threshold), 0, 1), 0, 0.5, 0)
end

function Tug.start(data: { [string]: any })
	if active then
		close()
	end
	active = {
		id = data.id,
		role = data.role,
		firstBeat = data.firstBeat,
		interval = data.interval,
		maxBeats = data.maxBeats,
		threshold = data.threshold,
		pos = 0,
		tapped = {},
		over = false,
		conn = nil,
	}
	local rarity = Config.Rarities[data.rarity] or Config.Rarities[1]
	if data.role == "attacker" then
		gui.title.Text = "KRADNIESZ!"
		gui.sub.Text = "Wyrywasz " .. data.itemName .. " graczowi " .. data.opponent
	else
		gui.title.Text = "KTOŚ CIĘ OKRADA!"
		gui.sub.Text = data.opponent .. " chce wyrwać: " .. data.itemName .. " · uciekaj do garażu albo trzymaj!"
	end
	gui.sub.TextColor3 = rarity.color
	gui.judge.Text = ""
	gui.panel.Visible = true
	Effects.play("Steal", 0.8)
	Effects.shake(2, 0.4)
	UI.flash(Color3.fromRGB(255, 60, 60), 0.35)
	ContextActionService:BindActionAtPriority("MSB_Tug", function(_, state)
		if state == Enum.UserInputState.Begin then
			tap()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 1, Enum.KeyCode.Space, Enum.KeyCode.ButtonA, Enum.KeyCode.ButtonR2)
	active.conn = RunService.RenderStepped:Connect(render)
end

function Tug.update(data: { [string]: any })
	local a = active
	if not a or a.id ~= data.id then
		return
	end
	a.pos = data.pos
	local mine = if a.role == "attacker" then data.ja else data.jd
	local text, color = judgeText(mine)
	gui.judge.Text = text
	gui.judge.TextColor3 = color
end

function Tug.finish(data: { [string]: any })
	local a = active
	if not a or a.id ~= data.id then
		return
	end
	a.over = true
	gui.judge.Text = if data.won then "WYGRANA!" else "PRZEGRANA!"
	gui.judge.TextColor3 = if data.won then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 90, 90)
	if data.won then
		Effects.play("Catch", 0.8)
	else
		Effects.play("Snap", 0.8)
	end
	task.delay(1.4, function()
		if active == a then
			close()
		end
	end)
end

function Tug.isActive(): boolean
	return active ~= nil
end

function Tug.init()
	build()
	gui.tapButton.MouseButton1Down:Connect(tap)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.UserInputType == Enum.UserInputType.MouseButton1 then
			tap()
		end
	end)
	Remotes.TugStart.OnClientEvent:Connect(Tug.start)
	Remotes.TugUpdate.OnClientEvent:Connect(Tug.update)
	Remotes.TugEnd.OnClientEvent:Connect(Tug.finish)
end

return Tug
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[-- HUD, powiadomienia i banery alertów. Całe UI jest tworzone kodem.
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Format = require(Shared.Format)
local Geo = require(Shared.Geo)

local player = Players.LocalPlayer

local UI = {}

local FONT = Enum.Font.FredokaOne

function UI.make(className: string, props: { [string]: any }, children: { Instance }?): any
	local inst = Instance.new(className)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			(inst :: any)[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UI.corner(radius: number?): UICorner
	return UI.make("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function UI.stroke(thickness: number?, color: Color3?): UIStroke
	return UI.make("UIStroke", { Thickness = thickness or 2, Color = color or Color3.new(0, 0, 0), ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

function UI.label(props: { [string]: any }): TextLabel
	local base = {
		BackgroundTransparency = 1,
		Font = FONT,
		TextColor3 = Color3.new(1, 1, 1),
		TextScaled = true,
		TextStrokeTransparency = 0.4,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return UI.make("TextLabel", base)
end

function UI.button(text: string, color: Color3, props: { [string]: any }): TextButton
	local base = {
		Text = text,
		Font = FONT,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		BackgroundColor3 = color,
		AutoButtonColor = true,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local b = UI.make("TextButton", base, { UI.corner(10), UI.stroke(2) })
	UI.make("UIPadding", {
		PaddingLeft = UDim.new(0, 6),
		PaddingRight = UDim.new(0, 6),
		PaddingTop = UDim.new(0, 4),
		PaddingBottom = UDim.new(0, 4),
		Parent = b,
	})
	return b
end

local gui: ScreenGui
local overlay: ScreenGui
local refs: { [string]: any } = {}

function UI.root(): ScreenGui
	return gui
end

-- Warstwa pełnoekranowa bez UIScale (łapacz dotyku minigry, błysk ekranu)
function UI.overlay(): ScreenGui
	return overlay
end

function UI.build()
	gui = UI.make("ScreenGui", {
		Name = "MSB_HUD",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})
	overlay = UI.make("ScreenGui", {
		Name = "MSB_Overlay",
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 5,
		Parent = player:WaitForChild("PlayerGui"),
	})
	-- Skalowanie całego HUD na małych ekranach (telefony)
	local scale = UI.make("UIScale", { Parent = gui })
	local function rescale()
		local vp = workspace.CurrentCamera.ViewportSize
		scale.Scale = math.clamp(math.min(vp.X / 1100, vp.Y / 650), 0.5, 1)
	end
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)
	rescale()

	-- Panel statystyk (lewy górny róg)
	local panel = UI.make("Frame", {
		Name = "Stats",
		Position = UDim2.new(0, 10, 0, 10),
		Size = UDim2.new(0, 250, 0, 168),
		BackgroundColor3 = Color3.fromRGB(20, 20, 28),
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, { UI.corner(12), UI.stroke(2, Color3.fromRGB(255, 200, 60)) })
	UI.make("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel })
	UI.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), PaddingRight = UDim.new(0, 8), Parent = panel })
	local function row(name: string, order: number, color: Color3?, height: number?): TextLabel
		local l = UI.label({
			Name = name,
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height or 22),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = color or Color3.new(1, 1, 1),
			Text = "",
			Parent = panel,
		})
		return l
	end
	refs.cash = row("Cash", 1, Color3.fromRGB(120, 255, 120), 30)
	refs.cps = row("CPS", 2, Color3.fromRGB(255, 230, 120))
	refs.pending = row("Pending", 3, Color3.fromRGB(160, 220, 255))
	refs.carried = row("Carried", 4)
	refs.magnet = row("Magnet", 5, Color3.fromRGB(255, 160, 160))
	refs.zone = row("Zone", 6)

	refs.protected = UI.label({
		Name = "Protected",
		Position = UDim2.new(0, 10, 0, 184),
		Size = UDim2.new(0, 250, 0, 26),
		BackgroundColor3 = Color3.fromRGB(40, 120, 60),
		BackgroundTransparency = 0.1,
		Text = "L · Ochrona Nowicjusza",
		Visible = false,
		Parent = gui,
	})
	UI.corner(8).Parent = refs.protected

	-- Przyciski (prawa strona)
	refs.shopButton = UI.button("SKLEP", Color3.fromRGB(255, 170, 30), {
		Position = UDim2.new(1, -140, 0.35, 0),
		Size = UDim2.new(0, 130, 0, 50),
		Parent = gui,
	})
	refs.indexButton = UI.button("INDEX", Color3.fromRGB(120, 90, 255), {
		Position = UDim2.new(1, -140, 0.35, 60),
		Size = UDim2.new(0, 130, 0, 50),
		Parent = gui,
	})
	refs.devButton = UI.button("DEV x10 $", Color3.fromRGB(200, 60, 60), {
		Position = UDim2.new(1, -140, 0.35, 120),
		Size = UDim2.new(0, 130, 0, 40),
		Visible = RunService:IsStudio() and Config.Debug.StudioCheats,
		Parent = gui,
	})

	-- Pasek siły rzutu
	refs.charge = UI.make("Frame", {
		Name = "Charge",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -120),
		Size = UDim2.new(0, 300, 0, 26),
		BackgroundColor3 = Color3.fromRGB(30, 30, 35),
		Visible = false,
		Parent = gui,
	}, { UI.corner(8), UI.stroke(2) })
	UI.make("Frame", {
		Name = "Perfect",
		Position = UDim2.new(Config.Fishing.PerfectCastMin, 0, 0, 0),
		Size = UDim2.new(Config.Fishing.PerfectCastMax - Config.Fishing.PerfectCastMin, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(60, 220, 90),
		BorderSizePixel = 0,
		Parent = refs.charge,
	})
	refs.chargeNeedle = UI.make("Frame", {
		Name = "Needle",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.new(0, 6, 1.4, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = refs.charge,
	}, { UI.corner(3) })
	UI.label({
		Position = UDim2.new(0, 0, -1.1, 0),
		Size = UDim2.new(1, 0, 1, 0),
		Text = "Puść na zielonym = Perfect Cast (+10% Luck)",
		Parent = refs.charge,
	})

	-- Powiadomienia (dół ekranu)
	refs.toasts = UI.make("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -170),
		Size = UDim2.new(0, 520, 0, 150),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	UI.make("UIListLayout", {
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = refs.toasts,
	})

	-- Baner alertów (góra ekranu)
	refs.banner = UI.make("Frame", {
		Name = "Banner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -140),
		Size = UDim2.new(0, 620, 0, 110),
		BackgroundColor3 = Color3.fromRGB(20, 20, 25),
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { UI.corner(16) })
	refs.bannerStroke = UI.stroke(4, Color3.new(1, 1, 1))
	refs.bannerStroke.Parent = refs.banner
	refs.bannerTitle = UI.label({
		Position = UDim2.new(0, 10, 0, 6),
		Size = UDim2.new(1, -20, 0.55, 0),
		Text = "",
		Parent = refs.banner,
	})
	refs.bannerText = UI.label({
		Position = UDim2.new(0, 10, 0.58, 0),
		Size = UDim2.new(1, -20, 0.36, 0),
		Text = "",
		Parent = refs.banner,
	})

	-- Wskaźnik burzy
	refs.storm = UI.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 4),
		Size = UDim2.new(0, 360, 0, 30),
		BackgroundColor3 = Color3.fromRGB(90, 50, 200),
		BackgroundTransparency = 0.1,
		Text = "BURZA MAGNETYCZNA · LUCK x" .. Config.Events.StormLuck,
		Visible = false,
		Parent = gui,
	})
	UI.corner(8).Parent = refs.storm

	-- Błysk ekranu
	refs.flash = UI.make("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = overlay,
	})

	return refs
end

function UI.refs()
	return refs
end

function UI.refreshStats()
	local cash = player:GetAttribute("Cash") or 0
	local cps = player:GetAttribute("CPS") or 0
	local pending = player:GetAttribute("Pending") or 0
	local carried = player:GetAttribute("Carried") or 0
	local capacity = player:GetAttribute("Capacity") or 1
	local magnet = Config.Magnets[player:GetAttribute("Magnet") or 1]
	refs.cash.Text = "Kasa: " .. Format.money(cash)
	refs.cps.Text = "Dochód: " .. Format.money(cps) .. "/s"
	refs.pending.Text = "W Kasie garażu: " .. Format.money(pending)
	refs.carried.Text = "Niesiesz: " .. carried .. "/" .. capacity
	refs.carried.TextColor3 = if carried >= capacity then Color3.fromRGB(255, 120, 120) else Color3.new(1, 1, 1)
	refs.magnet.Text = "Magnes: " .. (magnet and magnet.name or "?")
	refs.protected.Visible = player:GetAttribute("Protected") == true
	refs.storm.Visible = workspace:GetAttribute("Storm") == true
end

function UI.refreshZone()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local text, safe = Geo.zoneLabel(root.Position)
	refs.zone.Text = text
	refs.zone.TextColor3 = if safe then Color3.fromRGB(120, 255, 140) else Color3.fromRGB(255, 110, 110)
end

local toastColors = {
	info = Color3.fromRGB(40, 40, 50),
	good = Color3.fromRGB(30, 110, 50),
	bad = Color3.fromRGB(140, 35, 35),
}
local toastOrder = 0

function UI.toast(text: string, kind: string?)
	toastOrder += 1
	local t = UI.label({
		LayoutOrder = toastOrder,
		Size = UDim2.new(1, 0, 0, 30),
		BackgroundColor3 = toastColors[kind or "info"] or toastColors.info,
		BackgroundTransparency = 0.15,
		Text = text,
		TextStrokeTransparency = 0.6,
		Parent = refs.toasts,
	})
	UI.corner(8).Parent = t
	UI.make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = t })
	local children = refs.toasts:GetChildren()
	local labels = {}
	for _, c in ipairs(children) do
		if c:IsA("TextLabel") then
			table.insert(labels, c)
		end
	end
	if #labels > 4 then
		table.sort(labels, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		labels[1]:Destroy()
	end
	task.delay(4, function()
		if t.Parent then
			TweenService:Create(t, TweenInfo.new(0.4), { BackgroundTransparency = 1, TextTransparency = 1 }):Play()
			task.wait(0.4)
			t:Destroy()
		end
	end)
end

local bannerToken = 0
function UI.banner(title: string, text: string, color: Color3, seconds: number?)
	bannerToken += 1
	local my = bannerToken
	refs.bannerTitle.Text = title
	refs.bannerTitle.TextColor3 = color
	refs.bannerText.Text = text
	refs.bannerStroke.Color = color
	TweenService:Create(refs.banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 0, 40),
	}):Play()
	task.delay(seconds or 4, function()
		if bannerToken == my then
			TweenService:Create(refs.banner, TweenInfo.new(0.3), { Position = UDim2.new(0.5, 0, 0, -140) }):Play()
		end
	end)
end

function UI.flash(color: Color3, strength: number?)
	refs.flash.BackgroundColor3 = color
	refs.flash.BackgroundTransparency = 1 - (strength or 0.6)
	TweenService:Create(refs.flash, TweenInfo.new(0.8), { BackgroundTransparency = 1 }):Play()
end

return UI
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="52">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>